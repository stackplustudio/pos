# ==========================================
# StackPlus Studio - NusaKasir POS Monorepo
# Root Environment Template
# ==========================================

# Database Connection (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NestJS API Authentication (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="generate_minimal_32_karakter_acak_untuk_jwt_secret"
JWT_REFRESH_SECRET="generate_minimal_32_karakter_acak_berbeda_untuk_refresh_token"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App & Networking
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

